<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="2.0"
	xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
	xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9"
	xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
<xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes"/>
<xsl:template match="/">
<html lang="en">
<head>
	<meta charset="UTF-8"/>
	<meta name="robots" content="noindex,follow"/>
	<title>XML Sitemap · IDXBoost SEO</title>
	<style>
		body{font:13px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;color:#1d2327;background:#f0f0f1;margin:0;padding:24px}
		#wrap{max-width:1100px;margin:0 auto;background:#fff;border:1px solid #c3c4c7}
		header{padding:16px 20px;border-bottom:1px solid #dcdcde}
		h1{font-size:20px;font-weight:600;margin:0 0 4px}
		p{margin:0;color:#646970}
		table{width:100%;border-collapse:collapse}
		th{background:#2271b1;color:#fff;text-align:left;padding:8px 12px;font-weight:600}
		td{padding:6px 12px;border-bottom:1px solid #f0f0f1;word-break:break-all}
		tr:nth-child(even) td{background:#f6f7f7}
		a{color:#2271b1;text-decoration:none}
		a:hover{text-decoration:underline}
		td.n{text-align:right;white-space:nowrap;width:90px}
		td.d{white-space:nowrap;width:170px}
	</style>
</head>
<body>
<div id="wrap">
	<header>
		<h1>XML Sitemap</h1>
		<xsl:choose>
			<xsl:when test="count(sitemap:sitemapindex/sitemap:sitemap) &gt; 0">
				<p>This index contains <xsl:value-of select="count(sitemap:sitemapindex/sitemap:sitemap)"/> sitemaps. Generated by IDXBoost SEO.</p>
			</xsl:when>
			<xsl:otherwise>
				<p>This sitemap contains <xsl:value-of select="count(sitemap:urlset/sitemap:url)"/> URLs. <a href="sitemap_index.xml">← Sitemap index</a></p>
			</xsl:otherwise>
		</xsl:choose>
	</header>
	<xsl:choose>
		<xsl:when test="count(sitemap:sitemapindex/sitemap:sitemap) &gt; 0">
			<table>
				<tr><th>Sitemap</th><th>Last modified</th></tr>
				<xsl:for-each select="sitemap:sitemapindex/sitemap:sitemap">
					<tr>
						<td><a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a></td>
						<td class="d"><xsl:value-of select="concat(substring(sitemap:lastmod,0,11),' ',substring(sitemap:lastmod,12,5))"/></td>
					</tr>
				</xsl:for-each>
			</table>
		</xsl:when>
		<xsl:otherwise>
			<table>
				<tr><th>URL</th><th>Images</th><th>Last modified</th></tr>
				<xsl:for-each select="sitemap:urlset/sitemap:url">
					<tr>
						<td><a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a></td>
						<td class="n"><xsl:value-of select="count(image:image)"/></td>
						<td class="d"><xsl:value-of select="concat(substring(sitemap:lastmod,0,11),' ',substring(sitemap:lastmod,12,5))"/></td>
					</tr>
				</xsl:for-each>
			</table>
		</xsl:otherwise>
	</xsl:choose>
</div>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
